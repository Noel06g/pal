// Pal — Prisma schema
// PostgreSQL + Auth.js (NextAuth v5) Prisma adapter models + app models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Auth.js models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Holds the display name a person typed on the register form, keyed by email,
// so it can be applied when Auth.js creates the User on first magic-link sign-in.
model PendingRegistration {
  email     String   @id
  name      String
  createdAt DateTime @default(now())
}

// ───────────────────────── App models ─────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  ideas         Idea[]
  comments      Comment[]
  supports      Support[]
  reports       Report[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  expertProfile ExpertProfile? @relation("ExpertOwner")
  proposedLinks IdeaExpert[]   @relation("ProposedLinks")
  proposedEdits ExpertEdit[]   @relation("ProposedEdits")
}

enum IdeaStatus {
  ACTIVE
  ARCHIVED
}

enum Stance {
  PRO
  KUNDER
  NEUTRAL
}

enum ExpertStatus {
  AWAITING_NOMINEE
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ExpertSource {
  SELF
  NOMINATED
}

enum LinkStatus {
  AWAITING_EXPERT
  APPROVED
  REJECTED
}

enum EditStatus {
  PENDING
  APPROVED
  REJECTED
}

model Idea {
  id        String     @id @default(cuid())
  title     String
  summary   String     @db.Text
  fieldKey  String // one of the 14 keys, or "other"
  subfield  String?
  otherText String? // required when fieldKey == "other"
  status    IdeaStatus @default(ACTIVE)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  comments    Comment[]
  supports    Support[]
  documents   Document[]
  reports     Report[]
  expertLinks IdeaExpert[]

  @@index([fieldKey])
  @@index([status])
  @@index([authorId])
}

model Comment {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  stance     Stance
  isSolution Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ideaId])
}

model Support {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
  @@index([userId])
}

// PUBLIC supporting docs attached to ideas (served via authenticated route).
model Document {
  id          String   @id @default(cuid())
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String // key in private R2 bucket
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([ideaId])
}

model ExpertProfile {
  id String @id @default(cuid())

  // PUBLIC
  name   String
  areas  String[] // 1–3 field keys
  bio    String       @db.Text
  status ExpertStatus @default(PENDING_REVIEW)
  source ExpertSource

  // ACCOUNT OWNERSHIP (optional; null = unclaimed / admin-managed)
  ownerUserId String? @unique
  owner       User?   @relation("ExpertOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  // PRIVATE — admin only; revealed to a single idea author ONLY via an APPROVED IdeaExpert link
  contact         String
  contactEmail    String? // normalized (lowercased, de-accented) email for dedup + claim matching
  reason          String  @db.Text
  cvFileName      String?
  cvStorageKey    String?
  cvContentType   String?
  cvSize          Int?
  proposerName    String?
  proposerContact String?

  // nominee confirmation + account claim
  confirmToken        String?   @unique
  confirmTokenExpires DateTime?

  ideaLinks    IdeaExpert[]
  pendingEdits ExpertEdit[]
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([contactEmail])
}

model IdeaExpert {
  id           String        @id @default(cuid())
  ideaId       String
  idea         Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  expertId     String
  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  proposedById String?
  proposedBy   User?         @relation("ProposedLinks", fields: [proposedById], references: [id], onDelete: SetNull)

  status           LinkStatus @default(AWAITING_EXPERT)
  contactsSharedAt DateTime? // set on APPROVED -> mutual contact exchange unlocked
  takenOn          Boolean    @default(false) // expert signalled "po e marr përsipër"
  authorConfirmed  Boolean    @default(false) // author confirmed the takeover -> idea auto-archives

  approveToken        String?   @unique // lets a no-account expert approve/refuse this link by email
  approveTokenExpires DateTime?
  createdAt           DateTime  @default(now())

  @@unique([ideaId, expertId])
  @@index([status])
}

model ExpertEdit {
  id           String        @id @default(cuid())
  expertId     String
  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  proposedById String?
  proposedBy   User?         @relation("ProposedEdits", fields: [proposedById], references: [id], onDelete: SetNull)
  changes      Json // proposed field changes (name/areas/bio/...)
  status       EditStatus    @default(PENDING)
  createdAt    DateTime      @default(now())
}

model Report {
  id            String   @id @default(cuid())
  ideaId        String?
  idea          Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  ideaTitle     String // snapshot
  commentId     String? // optional: report targets a comment
  reason        String   @db.Text
  reporterId    String?
  reporter      User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterEmail String // snapshot
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([resolved])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // COMMENT | EXPERT_PROPOSED | ...
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
