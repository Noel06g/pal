// Pal — Prisma schema
// PostgreSQL + Auth.js (NextAuth v5) Prisma adapter models + app models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Auth.js models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Holds the display name a person typed on the register form, keyed by email,
// so it can be applied when Auth.js creates the User on first magic-link sign-in.
model PendingRegistration {
  email     String   @id
  name      String
  createdAt DateTime @default(now())
}

// ───────────────────────── App models ─────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  ideas         Idea[]
  comments      Comment[]
  supports      Support[]
  reports       Report[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
}

enum IdeaStatus {
  ACTIVE
  ARCHIVED
}

enum Stance {
  PRO
  KUNDER
  NEUTRAL
}

enum ExpertStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ExpertSource {
  SELF
  NOMINATED
}

model Idea {
  id        String     @id @default(cuid())
  title     String
  summary   String     @db.Text
  fieldKey  String // one of the 14 keys, or "other"
  subfield  String?
  otherText String? // required when fieldKey == "other"
  status    IdeaStatus @default(ACTIVE)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  comments  Comment[]
  supports  Support[]
  documents Document[]
  reports   Report[]
  experts   ExpertProfile[] // experts proposed from this idea

  @@index([fieldKey])
  @@index([status])
  @@index([authorId])
}

model Comment {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  stance     Stance
  isSolution Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ideaId])
}

model Support {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
  @@index([userId])
}

// PUBLIC supporting docs attached to ideas (served via authenticated route).
model Document {
  id          String   @id @default(cuid())
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String // key in private R2 bucket
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([ideaId])
}

model ExpertProfile {
  id     String       @id @default(cuid())
  name   String // public
  fieldKey String // public, exactly one
  bio    String       @db.Text // public
  status ExpertStatus @default(PENDING)
  source ExpertSource

  // PRIVATE — admin only
  contact         String
  reason          String  @db.Text
  cvFileName      String?
  cvStorageKey    String?
  cvContentType   String?
  cvSize          Int?
  proposerName    String?
  proposerContact String?

  // nomination confirmation
  confirmToken        String?   @unique
  confirmTokenExpires DateTime?

  fromIdeaId String?
  fromIdea   Idea?   @relation(fields: [fromIdeaId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([fieldKey])
}

model Report {
  id            String   @id @default(cuid())
  ideaId        String?
  idea          Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  ideaTitle     String // snapshot
  commentId     String? // optional: report targets a comment
  reason        String   @db.Text
  reporterId    String?
  reporter      User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterEmail String // snapshot
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([resolved])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // COMMENT | EXPERT_PROPOSED | ...
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
