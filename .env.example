# ─────────────────────────────────────────────────────────────
# Pal — environment variables. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). Use a pooled URL for DATABASE_URL on Neon/Supabase
# and the direct (non-pooled) URL for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://user:password@host:5432/pal?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/pal?schema=public"

# Auth.js (NextAuth v5)
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public origin of the app, e.g. https://pal.al  (http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"
# Comma-separated list of admin emails. These users become admins on sign-in.
ADMIN_EMAILS="you@example.al"

# Email (Resend) — used for magic links + notifications
RESEND_API_KEY=""
EMAIL_FROM="Pal <no-reply@yourdomain.al>"

# File storage (Cloudflare R2 / S3-compatible, PRIVATE bucket)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="pal-uploads"

# Bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Rate limiting (Upstash Redis, REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Pal"
